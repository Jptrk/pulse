<UserControl x:Class="Pulse.App.UI.SettingsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SaveStatus" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="SaveButton" Content="Save changes" Click="OnSave" MinWidth="120" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- Overlay -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="IN-GAME OVERLAY" Style="{StaticResource Section}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Layout" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Strip is one line; Panel adds the frame-time graph; Detailed adds latency, stutters, fans, per-thread load and PCIe." Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ComboBox x:Name="Mode" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Position" Style="{StaticResource SettingLabel}" />
                            <ComboBox x:Name="Corner" Grid.Column="1" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Offset from edge (px)" Style="{StaticResource SettingLabel}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="OffsetX" Width="80" />
                                <TextBlock Text="×" Foreground="{StaticResource MutedTextBrush}" Margin="10,0" VerticalAlignment="Center" />
                                <TextBox x:Name="OffsetY" Width="80" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Size" Style="{StaticResource SettingLabel}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock x:Name="ScaleText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Background opacity" Style="{StaticResource SettingLabel}" />
                            <DockPanel Grid.Column="1">
                                <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Lows window (seconds)" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="1% / 0.1% lows on the overlay use this many trailing seconds. Sessions use every frame." Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <TextBox x:Name="StatsWindow" Grid.Column="1" Width="80" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox x:Name="OnlyInGame" Content="Show overlay only while a game is detected" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Hotkeys -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="HOTKEYS" Style="{StaticResource Section}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Cycle overlay" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Strip → Panel → Detailed → Off" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <TextBox x:Name="CycleKey" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Hide / show overlay" Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="HideKey" Grid.Column="1" />
                        </Grid>
                        <TextBlock Text="Format: Ctrl/Alt/Shift/Win + key, e.g. Alt+Shift+O or Ctrl+F10." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </Border>

                <!-- Alerts -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ALERTS" Style="{StaticResource Section}" />
                        <CheckBox x:Name="AlertsOn" Content="Show warnings on the overlay" Margin="0,4,0,8" />
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="CPU hot at (°C)" Style="{StaticResource SettingHint}" />
                                <TextBox x:Name="CpuHot" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="GPU hot at (°C)" Style="{StaticResource SettingHint}" />
                                <TextBox x:Name="GpuHot" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="VRAM full at (%)" Style="{StaticResource SettingHint}" />
                                <TextBox x:Name="VramFull" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="RAM full at (%)" Style="{StaticResource SettingHint}" />
                                <TextBox x:Name="RamFull" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                        <CheckBox x:Name="PcieOn" Content="Watch GPU PCIe link (under load)" Margin="0,16,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="28,0,0,0">
                            <TextBlock Text="Expected" Style="{StaticResource SettingHint}" VerticalAlignment="Center" />
                            <TextBlock Text="Gen" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0,4,0" />
                            <TextBox x:Name="PcieGen" Width="56" />
                            <TextBlock Text="x" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <TextBox x:Name="PcieWidth" Width="56" />
                        </StackPanel>
                        <TextBlock Text="Warns when the link runs at a different generation or width, or the link starts retrying transfers — the signs of a marginal riser." Style="{StaticResource SettingHint}" Margin="28,6,0,0" />
                        <CheckBox x:Name="WheaOn" Content="Warn on WHEA hardware errors (System event log)" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Games -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="GAME DETECTION" Style="{StaticResource Section}" />
                        <TextBlock Text="A game is the focused app drawing 20+ frames/s that fills its screen. Windowed games: add them to Always. One exe name per line." Style="{StaticResource SettingHint}" Margin="0,0,0,10" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Always a game" Style="{StaticResource SettingLabel}" />
                                <TextBox x:Name="AllowList" AcceptsReturn="True" Height="96" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Never a game" Style="{StaticResource SettingLabel}" />
                                <TextBox x:Name="DenyList" AcceptsReturn="True" Height="96" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Startup & system -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="STARTUP &amp; SYSTEM" Style="{StaticResource Section}" />
                        <CheckBox x:Name="Autostart" Content="Start Pulse when I sign in (elevated, no UAC prompt)" Margin="0,4,0,0" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Sensor poll interval (ms)" Style="{StaticResource SettingLabel}" />
                            <TextBox x:Name="PollMs" Grid.Column="1" Width="80" HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock Text="CPU TEMPERATURE DRIVER" Style="{StaticResource Section}" Margin="0,12,0,4" />
                        <TextBlock x:Name="DriverText" Style="{StaticResource SettingHint}" FontSize="13" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
