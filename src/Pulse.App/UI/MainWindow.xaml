<Window x:Class="Pulse.App.UI.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse"
        Width="1240" Height="820" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Icon="/Assets/pulse.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Image Source="/Assets/pulse.ico" Width="30" Height="30" />
                    <TextBlock Text="Pulse" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="6,0,0,0">
                    <TextBlock Text="STATUS" Style="{StaticResource CardTitle}" FontSize="11" Margin="0,0,0,6" />
                    <TextBlock x:Name="CaptureStatus" Style="{StaticResource SettingHint}" />
                    <TextBlock x:Name="AdminStatus" Style="{StaticResource SettingHint}" />
                    <TextBlock x:Name="DriverStatus" Style="{StaticResource SettingHint}" />
                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource SettingHint}" />
                </StackPanel>

                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectionChanged="OnNavChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Tag="live">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Live" FontSize="14" Margin="12,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="sessions">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Sessions" FontSize="14" Margin="12,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" FontSize="14" Margin="12,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl x:Name="Page" Grid.Column="1" Margin="28,22,28,24" Focusable="False" />
    </Grid>
</Window>
